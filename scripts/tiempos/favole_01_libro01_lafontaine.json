{
  "id": "favole_01_libro01_lafontaine",
  "titulo": "La Cicala e la Formica",
  "comoSeHizo": "Alineado con scripts/alinear_favole.py (whisper.cpp small, de a pedazos de 22 s).",
  "renglones": [
    {
      "desde": 30.06,
      "hasta": 33.12,
      "texto": "La Cicala che imprudente"
    },
    {
      "desde": 33.12,
      "hasta": 35.87,
      "texto": "tutto estate al sol cantò,"
    },
    {
      "desde": 35.87,
      "hasta": 37.13,
      "texto": "provveduta di niente"
    },
    {
      "desde": 37.13,
      "hasta": 39.19,
      "texto": "nell’inverno si trovò,"
    },
    {
      "desde": 39.19,
      "hasta": 40.73,
      "texto": "senza più un granello e senza"
    },
    {
      "desde": 40.73,
      "hasta": 42.06,
      "texto": "una mosca in la credenza."
    },
    {
      "desde": 42.06,
      "hasta": 42.94,
      "texto": "Affamata e piagnolosa"
    },
    {
      "desde": 44.03,
      "hasta": 46.1,
      "texto": "va a cercar della Formica"
    },
    {
      "desde": 46.37,
      "hasta": 48.51,
      "texto": "e le chiede qualche cosa,"
    },
    {
      "desde": 48.51,
      "hasta": 50.97,
      "texto": "qualche cosa in cortesia,"
    },
    {
      "desde": 50.97,
      "hasta": 52.53,
      "texto": "per poter fino alla prossima"
    },
    {
      "desde": 52.53,
      "hasta": 54.87,
      "texto": "primavera tirar via:"
    },
    {
      "desde": 54.87,
      "hasta": 57.43,
      "texto": "promettendo per l’agosto,"
    },
    {
      "desde": 57.43,
      "hasta": 59.25,
      "texto": "in coscienza d’animale,"
    },
    {
      "desde": 59.25,
      "hasta": 60.91,
      "texto": "interessi e capitale."
    },
    {
      "desde": 60.91,
      "hasta": 63.11,
      "texto": "La Formica che ha il difetto"
    },
    {
      "desde": 63.11,
      "hasta": 63.31,
      "texto": "di prestar malvolentieri,"
    },
    {
      "desde": 65.59,
      "hasta": 68.18,
      "texto": "le dimanda chiaro e netto:"
    },
    {
      "desde": 68.18,
      "hasta": 69.91,
      "texto": "- Che hai tu fatto fino a ieri?"
    },
    {
      "desde": 71.04,
      "hasta": 72.26,
      "texto": "- Cara amica, a dire il giusto"
    },
    {
      "desde": 72.26,
      "hasta": 73.79,
      "texto": "non ho fatto che cantare"
    },
    {
      "desde": 73.79,
      "hasta": 75.78,
      "texto": "tutto il tempo. - Brava ho gusto;"
    },
    {
      "desde": 76.85,
      "hasta": 79.57,
      "texto": "balla adesso, se ti pare."
    }
  ]
}
