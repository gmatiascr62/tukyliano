<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- La plantilla de Flutter declara este permiso solo en los manifests de
         debug y profile, así que el APK de release quedaba sin internet: no
         bajaba los verbos nuevos, ni el modelo del chat, ni se enteraba de que
         había una versión nueva.

         El chat en sí no lo usa: una vez bajado el modelo, contesta sin
         conexión. Internet hace falta para bajarlo esa primera vez. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Para poder abrir el instalador con la actualización que la app se baja
         sola. Android igual le pregunta al usuario la primera vez. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>
    <!-- Para la práctica de pronunciación: la app graba lo que se dice y se lo
         pasa al reconocedor de voz de Android. Android igual pide permiso al
         usuario la primera vez que se toca el micrófono. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <!-- Para que el podcast y la radio sigan sonando con la pantalla
         bloqueada. Android no deja que una app en segundo plano reproduzca
         audio porque sí: hay que levantar un servicio en primer plano, que es
         lo mismo que decir una notificación con los controles. Sin estos tres
         permisos el audio se corta apenas se bloquea el celular, y sin ningún
         error que lo explique.

         FOREGROUND_SERVICE_MEDIA_PLAYBACK es el que pide Android 14 en
         adelante: hay que decir PARA QUÉ es el servicio, no alcanza con
         pedirlo. -->
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"/>
    <!-- Desde Android 13 una app no puede mostrar NINGUNA notificación sin
         este permiso, y encima hay que pedírselo al usuario en pantalla: no
         alcanza con declararlo. audio_service no lo declara ni lo pide, así
         que esto es nuestro.

         Importa más de lo que parece: la notificación no es un adorno, es el
         permiso de seguir sonando. Sin ella Android corta el audio al rato de
         que la app deja de estar a la vista. Pasó: treinta segundos y se
         cortaba, sin notificación y sin ningún error. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <application
        android:label="DueParole"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <!-- Con el nombre completo del paquete: el namespace ahora es
             org.gmatiascr62.tukyliano.flutter —tiene que coincidir con el
             applicationId, ver build.gradle.kts— y el código Kotlin sigue en
             org.gmatiascr62.tukyliano, así que ".MainActivity" ya no alcanza. -->
        <activity
            android:name="org.gmatiascr62.tukyliano.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- El servicio que hace sonar el audio cuando la app no está a la
             vista, y el receptor de los botones del auricular y del auto.
             Los pone audio_service; acá solo se declaran.

             tools:ignore="Instantiatable" es porque el analizador de Android
             no encuentra estas clases en el proyecto —viven en el paquete— y
             avisa que no se pueden instanciar. Sí se pueden. -->
        <service
            android:name="com.ryanheise.audioservice.AudioService"
            android:foregroundServiceType="mediaPlayback"
            android:exported="true"
            tools:ignore="Instantiatable">
            <intent-filter>
                <action android:name="android.media.browse.MediaBrowserService"/>
            </intent-filter>
        </service>
        <receiver
            android:name="com.ryanheise.audioservice.MediaButtonReceiver"
            android:exported="true"
            tools:ignore="Instantiatable">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON"/>
            </intent-filter>
        </receiver>

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Desde Android 11 una app no ve las otras si no las declara acá.
             Sin esto el motor de texto a voz es invisible y los cuentos no
             suenan, sin ningún error que lo explique. -->
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE"/>
        </intent>
        <!-- Y sin esto el reconocedor de voz es invisible: la pronunciación
             diría que el celular no puede escuchar aunque sí pueda. -->
        <intent>
            <action android:name="android.speech.RecognitionService"/>
        </intent>
        <!-- Por lo mismo: sin esto no se ve ningún navegador y el link para
             sacar la clave de la IA no abre nada. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
    </queries>
</manifest>
