    {
     "it": "Oggi è il primo giorno di lavoro di Anna.",
     "es": "Hoy es el primer día de trabajo de Anna."
    },
    {
     "it": "L'ufficio è in centro.",
     "es": "La oficina está en el centro."
    },
    {
     "it": "Anna arriva alle nove.",
     "es": "Anna llega a las nueve."
    },
    {
     "it": "La porta è aperta.",
     "es": "La puerta está abierta."
    },
    {
     "it": "Dentro c'è un tavolo con un telefono.",
     "es": "Adentro hay una mesa con un teléfono."
    },
    {
     "it": "Sullo scaffale ci sono molti quaderni.",
     "es": "Sobre el estante hay muchos cuadernos."
    },
    {
     "it": "Il capo si chiama Luca.",
     "es": "El jefe se llama Luca."
