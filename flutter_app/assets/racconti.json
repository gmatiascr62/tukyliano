    {
     "it": "Marco è in cucina.",
     "es": "Marco está en la cocina."
    },
    {
     "it": "È mattina presto.",
     "es": "Es temprano a la mañana."
    },
    {
     "it": "Marco ha fame.",
     "es": "Marco tiene hambre."
    },
    {
     "it": "Sul tavolo c'è il pane.",
     "es": "Sobre la mesa hay pan."
    },
    {
     "it": "C'è anche il burro.",
     "es": "También hay manteca."
    },
    {
     "it": "Marco prende il pane.",
     "es": "Marco agarra el pan."
    },
    {
     "it": "Mette il burro sul pane.",
     "es": "Le pone manteca al pan."
    },
    {
     "it": "Poi fa un caffè.",
     "es": "Después hace un café."
    },
    {
     "it": "Il caffè è caldo.",
     "es": "El café está caliente."
    },
    {
     "it": "Marco vuole lo zucchero.",
     "es": "Marco quiere azúcar."
    },
    {
     "it": "Lo zucchero è nell'armadio.",
     "es": "El azúcar está en el armario."
    },
    {
     "it": "Marco beve il caffè.",
     "es": "Marco toma el café."
    },
    {
     "it": "Adesso è pronto per il lavoro.",
     "es": "Ahora está listo para el trabajo."
