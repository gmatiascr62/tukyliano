     "es": "La oficina está cerca de la estación."
    },
    {
     "it": "Marco ha molto lavoro.",
     "es": "Marco tiene mucho trabajo."
    },
    {
     "it": "Deve rispondere al telefono.",
     "es": "Tiene que contestar el teléfono."
    },
    {
     "it": "Scrive lettere ai clienti.",
     "es": "Escribe cartas a los clientes."
    },
    {
     "it": "A mezzogiorno mangia un panino.",
     "es": "Al mediodía come un sándwich."
    },
    {
     "it": "Poi beve un caffè con i colleghi.",
     "es": "Después toma un café con los compañeros."
    },
    {
     "it": "Alle sei torna a casa.",
     "es": "A las seis vuelve a casa."
    },
    {
     "it": "È stanco ma contento.",
