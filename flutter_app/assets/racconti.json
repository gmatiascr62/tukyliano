    {
     "it": "Il gatto è in cucina.",
     "es": "El gato está en la cocina."
    },
    {
     "it": "Ha fame.",
     "es": "Tiene hambre."
    },
    {
     "it": "Vuole il pesce.",
     "es": "Quiere el pescado."
    },
    {
     "it": "Ma sul tavolo non c'è il pesce.",
     "es": "Pero sobre la mesa no hay pescado."
    },
    {
     "it": "C'è solo il latte.",
     "es": "Solo hay leche."
    },
    {
     "it": "Il gatto beve il latte.",
     "es": "El gato toma la leche."
    },
    {
     "it": "Poi va in giardino.",
     "es": "Después va al jardín."
    },
    {
     "it": "In giardino c'è un uccello.",
     "es": "En el jardín hay un pájaro."
    },
    {
     "it": "Il gatto guarda l'uccello.",
     "es": "El gato mira al pájaro."
    },
    {
     "it": "L'uccello vola via.",
     "es": "El pájaro se vuela."
    },
    {
     "it": "Adesso il gatto ha sonno.",
     "es": "Ahora el gato tiene sueño."
    },
    {
     "it": "Torna a casa e dorme sulla sedia.",
     "es": "Vuelve a casa y duerme en la silla."
