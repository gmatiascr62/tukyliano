    {
     "it": "Luca è simpatico.",
     "es": "Luca es simpático."
    },
    {
     "it": "Anna vuole un caffè.",
     "es": "Anna quiere un café."
    },
    {
     "it": "Il caffè dell'ufficio non è buono.",
     "es": "El café de la oficina no es bueno."
    },
    {
     "it": "Ma il lavoro è interessante.",
     "es": "Pero el trabajo es interesante."
    },
    {
     "it": "Alla fine del giorno Anna è stanca.",
     "es": "Al final del día Anna está cansada."
    },
    {
